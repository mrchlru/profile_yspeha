    "@prisma/client": "^7.5.0",
    "docx": "^9.7.1",
    "fflate": "^0.8.3",
    "googleapis": "^173.0.0",
    "lucide-react": "^1.7.0",
    "next": "^14.2.35",
    "nodemailer": "^8.0.4",
    "onnxruntime-node": "^1.21.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "prisma": "^7.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
