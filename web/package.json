    "invites:repair-used-at": "tsx scripts/backfillAccessInviteUsedAt.ts",
    "invites:repair-used-at:dry": "tsx scripts/backfillAccessInviteUsedAt.ts --dry-run"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.21",
